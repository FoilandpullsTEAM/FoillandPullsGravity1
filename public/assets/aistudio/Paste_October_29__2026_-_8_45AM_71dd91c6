    <motion.figure
      ref={ref}
      className={`group relative isolate overflow-hidden grain ${className}`}
      style={{ aspectRatio: ratio }}
      variants={curtain(reduce)}
      initial="hidden"
      whileInView="show"
      viewport={{ once: true, margin: "-10% 0px -10% 0px" }}
